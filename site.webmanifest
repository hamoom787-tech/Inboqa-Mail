{
  "name": "Inboqa Mail",
  "short_name": "Inboqa",
  "description": "Inboqa Mail creates disposable inboxes for verification messages and safer signups.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "dir": "rtl",
  "lang": "ar",
  "background_color": "#0d1519",
  "theme_color": "#0d1519",
  "icons": [
    {
      "src": "/assets/inboqa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/inboqa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/inboqa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
