  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer-when-downgrade
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.qrserver.com; connect-src 'self' https://api.mail.gw https://api.mail.tm https://formsubmit.co; frame-src 'self' https://formsubmit.co; navigate-to 'self' https://formsubmit.co; form-action 'self' https://formsubmit.co; upgrade-insecure-requests

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
